#!/bin/bash

# Find active wallpaper
WALLPAPER=$(grep '^Image=' ~/.config/plasma-org.kde.plasma.desktop-appletsrc | tail -n 1 | cut -d'=' -f2-)
WALLPAPER="${WALLPAPER#file://}"

if [ -z "$WALLPAPER" ] || [ ! -f "$WALLPAPER" ]; then
    WALLPAPER=$(grep -oE '/home/[^"]+\.(jpg|jpeg|png)' ~/.config/plasma-org.kde.plasma.desktop-appletsrc 2>/dev/null | tail -n 1)
fi

if [ -z "$WALLPAPER" ] || [ ! -f "$WALLPAPER" ]; then
    echo "Error: Could not automatically detect active wallpaper path."
    exit 1
fi

echo "Detected active wallpaper: $WALLPAPER"

# 0. GRUB/SDDM (step 9 below) need sudo - ask up front instead of partway
# through, so the whole run doesn't sit waiting on a password prompt you
# might not be at the keyboard for. Declining just skips that step later;
# everything else below still runs normally either way.
PLASMALUST_REPO="$HOME/Projects/plasmalust"
if [ -x "$PLASMALUST_REPO/grub-theme/install-grub-theme.sh" ] && [ -x "$PLASMALUST_REPO/sddm-theme/install-sddm.sh" ]; then
    sudo -v
fi

# 1. Run Wallust with --no-cache
# This regenerates: the KDE color scheme (~/.local/share/color-schemes/Wallust.colors),
# the kitty theme (~/.config/kitty/current-theme.conf), fastfetch config, and live
# terminal OSC sequences (~/.cache/wallust/sequences) — per wallust.toml templates.
mkdir -p "$HOME/.config/Kvantum/Plasmalust"
wallust run --no-cache "$WALLPAPER" || exit 1

# The wallpaper-overlay template keeps the repo's portable /home/YOUR_USERNAME
# placeholder for paths (only colors are wallust-templated) since, unlike the
# plasma-widgets, it isn't installed through install-widgets.sh's own sed
# step - it's just run directly from this cache location.
OVERLAY_QML="$HOME/.cache/wallust/wallpaper-overlay.qml"
[ -f "$OVERLAY_QML" ] && sed -i "s|/home/YOUR_USERNAME|$HOME|g" "$OVERLAY_QML"

# 2. Apply the freshly generated color scheme system-wide (Plasma + all Qt/KDE apps,
# including Dolphin, inherit this automatically — no per-app step needed).
# Stop Plasma's own "accent color from wallpaper" first so it doesn't fight wallust
# and keep overwriting the scheme with its own auto-generated one.
kwriteconfig6 --file kdeglobals --group General --key accentColorFromWallpaper false

# Strip any literal Colors:* overrides that may have been left in kdeglobals by
# Plasma's accent-color writer (or a previous run) — these shadow the ColorScheme
# file's values for every app that reads kdeglobals directly (System Settings,
# Dolphin, System Monitor, ...), freezing them on whatever palette was last written
# even after the active scheme changes. kwriteconfig6 --delete only drops single
# keys, not whole groups, so strip the blocks directly.
KDEGLOBALS="$HOME/.config/kdeglobals"
if [ -f "$KDEGLOBALS" ]; then
    awk '
        /^\[Colors:(Button|Complementary|Selection|Tooltip|View|Window)\]$/ { skip=1; next }
        /^\[/ { skip=0 }
        !skip
    ' "$KDEGLOBALS" > "$KDEGLOBALS.tmp" && mv "$KDEGLOBALS.tmp" "$KDEGLOBALS"
fi

# Since accentColorFromWallpaper is off, nothing else keeps AccentColor in sync —
# derive it ourselves from the same accent color GTK uses (color5), so the accent
# highlight used across Plasma/System Settings matches the rest of the theme.
ACCENT_HEX=$(grep -m1 '^color5' "$HOME/.config/kitty/theme.conf" | awk '{print $2}')
if [ -n "$ACCENT_HEX" ]; then
    ACCENT_RGB=$(printf '%d,%d,%d' "0x${ACCENT_HEX:1:2}" "0x${ACCENT_HEX:3:2}" "0x${ACCENT_HEX:5:2}")
    kwriteconfig6 --file kdeglobals --group General --key AccentColor "$ACCENT_RGB"
fi

# plasma-apply-colorscheme silently no-ops if the scheme *name* it's asked to
# apply is already the current one — it never inspects file content. Since our
# KDE template always writes Name=Wallust, every run after the first was being
# skipped, leaving KDE permanently frozen on whichever wallpaper's colors got
# applied that first time. Work around it by applying under a fresh, unique
# name each run, then pruning the old ones so they don't pile up.
# Note: the old file is only removed *after* the new one is applied — kdeglobals
# still references the old scheme name until plasma-apply-colorscheme rewrites
# it, so deleting the old file first left a gap where that name pointed at
# nothing and plasma-apply-colorscheme would warn "could not find" it and
# transiently fall back to BreezeLight before applying the new one.
SCHEME_DIR="$HOME/.local/share/color-schemes"
SCHEME_NAME="Wallust-$(date +%s%N)"
sed "s/^Name=Wallust$/Name=$SCHEME_NAME/" "$SCHEME_DIR/Wallust.colors" > "$SCHEME_DIR/$SCHEME_NAME.colors"
plasma-apply-colorscheme "$SCHEME_NAME"
find "$SCHEME_DIR" -maxdepth 1 -name 'Wallust-*.colors' ! -name "$SCHEME_NAME.colors" -delete

# 2b. Generate a wallust-duotone dithered "portrait" of the current wallpaper for
# the plasmalust-sysinfo desktop widget - an ordered-dither halftone reduces the
# wallpaper to two tones, then remaps black/white to the current background/accent
# hex so it always matches the active palette instead of being a static asset.
BG_HEX=$(grep -m1 '^background' "$HOME/.config/kitty/theme.conf" | awk '{print $2}')
if [ -n "$BG_HEX" ] && [ -n "$ACCENT_HEX" ] && command -v magick >/dev/null; then
    mkdir -p "$HOME/.cache/wallust"
    magick "$WALLPAPER" -resize 300x370^ -gravity center -extent 300x370 \
        -colorspace Gray -ordered-dither o4x4,2 -colorspace sRGB \
        -fill "$BG_HEX" -opaque black -fill "$ACCENT_HEX" -opaque white \
        "$HOME/.cache/wallust/portrait-dither.png"
fi

# 2c. Icon theme + cursor theme selection. Neither Papirus (icons) nor
# Bibata (cursors) takes arbitrary hex - each only ships a small curated
# set of pre-built color variants - so nearest-swatch.py picks the closest
# one to the current accent instead. Only the selection happens here (pure
# kdeglobals/kcminputrc keys, no sudo); actually recoloring Papirus's
# folder icons via papirus-folders touches its system-owned directory, so
# that part happens later in the sudo-gated block (step 9). Both are
# no-ops until icons-cursors/install-icons-cursors.sh has been run once.
ICONS_CURSORS_DIR="$PLASMALUST_REPO/icons-cursors"
if [ -f "$ICONS_CURSORS_DIR/nearest-swatch.py" ] && [ -d /usr/share/icons/Papirus-Dark ]; then
    kwriteconfig6 --file kdeglobals --group Icons --key Theme "Papirus-Dark"
    BIBATA_VARIANT=$(python3 "$ICONS_CURSORS_DIR/nearest-swatch.py" bibata "$ACCENT_HEX" 2>/dev/null || true)
    if [ -n "$BIBATA_VARIANT" ] && [ -d "/usr/share/icons/Bibata-Modern-$BIBATA_VARIANT" ]; then
        kwriteconfig6 --file kcminputrc --group Mouse --key cursorTheme "Bibata-Modern-$BIBATA_VARIANT"
    fi
fi

# 2d. Recolor the Arch logo used as the Kickoff (app launcher) icon on the
# top panel to match the current accent, using the same alpha-mask recolor
# trick as an SVG/PNG logo recolor - extract the source's alpha channel,
# flood a solid accent-colored layer, then use the alpha as a mask. Padded
# onto a larger canvas so it isn't flush against the icon's edges (a raw
# icon-theme-sized pixmap renders larger/less centered in the panel slot
# than a properly-padded one).
if [ -n "$ACCENT_HEX" ] && [ -f /usr/share/pixmaps/archlinux-logo.png ] && command -v magick >/dev/null; then
    mkdir -p "$HOME/.cache/wallust"
    magick /usr/share/pixmaps/archlinux-logo.png -alpha extract "$HOME/.cache/wallust/.logo-alpha.png"
    magick -size 256x256 xc:"$ACCENT_HEX" "$HOME/.cache/wallust/.logo-color.png"
    magick "$HOME/.cache/wallust/.logo-color.png" "$HOME/.cache/wallust/.logo-alpha.png" \
        -alpha off -compose CopyOpacity -composite "$HOME/.cache/wallust/.logo-recolored.png"
    magick "$HOME/.cache/wallust/.logo-recolored.png" -resize 190x190 -gravity center \
        -background none -extent 320x320 "$HOME/.cache/wallust/panel-logo.png"
    rm -f "$HOME/.cache/wallust/.logo-alpha.png" "$HOME/.cache/wallust/.logo-color.png" "$HOME/.cache/wallust/.logo-recolored.png"
fi

# 3. Push the new colors to already-open terminals immediately, without waiting for
# a new window (writes wallust's OSC sequences to every pty the user owns).
SEQ_FILE="$HOME/.cache/wallust/sequences"
if [ -f "$SEQ_FILE" ]; then
    for pty in /dev/pts/*; do
        [ -w "$pty" ] && cat "$SEQ_FILE" > "$pty" 2>/dev/null
    done
fi

# 4. Restart Plasma shell once to force a full panel/widget redraw
kquitapp6 plasmashell 2>/dev/null
kstart plasmashell >/dev/null 2>&1 &

# 5. Sync the lock screen (kscreenlocker) wallpaper too - it's a separate
# per-user setting the desktop wallpaper change doesn't touch, so it stays
# on whatever was last set (often a distro default) unless synced here.
kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image "$WALLPAPER"

# 6. Android Studio: wallust already regenerated colors/Wallust.icls (the
# [templates.android-studio] entry), but that only makes it available - it
# still needs to be actually selected as the active editor color scheme.
# colors.scheme.xml is JetBrains' own XML format, not a KDE ini file, so
# this is a targeted sed rather than kwriteconfig6.
ANDROID_STUDIO_DIR="$HOME/.config/Google/AndroidStudio2026.1.3"
ANDROID_STUDIO_SCHEME_XML="$ANDROID_STUDIO_DIR/options/colors.scheme.xml"
if [ -f "$ANDROID_STUDIO_DIR/colors/Wallust.icls" ] && [ -f "$ANDROID_STUDIO_SCHEME_XML" ]; then
    sed -i 's/global_color_scheme name="[^"]*"/global_color_scheme name="Wallust"/' "$ANDROID_STUDIO_SCHEME_XML"
fi

# Android Studio UI theme (chrome: sidebar/toolbar/panels) - DISABLED.
# The "*" wildcard in theme.json overrides background/foreground/selection
# broadly, but many specific nested states (menu hover, tree selection,
# disabled items) weren't individually overridden, so they silently kept
# Darcula's original paired color while only half of that pair got
# swapped - producing invisible text and broken-looking icons in specific
# spots. Confirmed as a real regression, not a false alarm. Fixing this
# properly needs auditing many more specific keys with actual visual
# verification each round, not something to keep guessing at blind.
# Plugin files are still in plugin-src/ if this gets revisited later; see
# git history for the rebuild step this replaced.
#
# PLASMALUST_AS_THEME_JSON="$HOME/.cache/wallust/plasmalust.theme.json"
# PLASMALUST_AS_PLUGIN_SRC="$PLASMALUST_REPO/android-studio-theme/plugin-src"
# ANDROID_STUDIO_PLUGINS_DIR="$HOME/.local/share/Google/AndroidStudio2026.1.3"
# if [ -f "$PLASMALUST_AS_THEME_JSON" ] && [ -d "$PLASMALUST_AS_PLUGIN_SRC" ] && [ -d "$ANDROID_STUDIO_PLUGINS_DIR" ]; then
#     AS_BUILD_DIR=$(mktemp -d)
#     cp -r "$PLASMALUST_AS_PLUGIN_SRC/META-INF" "$AS_BUILD_DIR/"
#     cp "$PLASMALUST_AS_THEME_JSON" "$AS_BUILD_DIR/plasmalust.theme.json"
#     AS_PLUGIN_LIB_DIR="$ANDROID_STUDIO_PLUGINS_DIR/plasmalust-theme/lib"
#     mkdir -p "$AS_PLUGIN_LIB_DIR"
#     (cd "$AS_BUILD_DIR" && zip -rq "$AS_PLUGIN_LIB_DIR/plasmalust-theme.jar" META-INF plasmalust.theme.json)
#     rm -rf "$AS_BUILD_DIR"
# fi

# 7. Spicetify: wallust already regenerated Themes/wallust/user.css (--spice-* CSS vars,
# per the [templates.spicetify] entry in wallust.toml). Also derive Themes/wallust/color.ini
# from it (spicetify's replace_colors patcher wants hex-without-# key=value pairs, not CSS
# vars) since there's no wallust template output in that format directly.
SPICE_THEME_DIR="$HOME/.config/spicetify/Themes/wallust"
if [ -f "$SPICE_THEME_DIR/user.css" ] && command -v spicetify >/dev/null; then
    {
        echo "[wallust]"
        awk -F': ' '
        /--spice-text:/{print "text               = " substr($2,2,6)}
        /--spice-subtext:/{print "subtext            = " substr($2,2,6)}
        /--spice-main:/{print "main               = " substr($2,2,6)}
        /--spice-sidebar:/{print "sidebar            = " substr($2,2,6)}
        /--spice-player:/{print "player             = " substr($2,2,6)}
        /--spice-card:/{print "card               = " substr($2,2,6)}
        /--spice-shadow:/{print "shadow             = " substr($2,2,6)}
        /--spice-selected-row:/{print "selected-row       = " substr($2,2,6)}
        /--spice-button:/{print "button             = " substr($2,2,6)}
        /--spice-button-active:/{print "button-active      = " substr($2,2,6)}
        /--spice-button-disabled:/{print "button-disabled    = " substr($2,2,6)}
        /--spice-tab-active:/{print "tab-active         = " substr($2,2,6)}
        /--spice-notification:/{print "notification       = " substr($2,2,6)}
        /--spice-notification-error:/{print "notification-error = " substr($2,2,6)}
        /--spice-misc:/{print "misc               = " substr($2,2,6)}
        ' "$SPICE_THEME_DIR/user.css"
    } > "$SPICE_THEME_DIR/color.ini"

    # "refresh -s" just re-reads the active theme's color.ini/user.css/assets - much
    # cheaper than "apply", which re-patches Spotify's whole app bundle from scratch.
    spicetify refresh -s >/dev/null 2>&1

    # Colors only show up after Spotify reloads its window - restart it, but only if it
    # was already running, so this doesn't launch Spotify on every wallpaper change.
    if pgrep -f "/opt/spotify/spotify" >/dev/null; then
        pkill -f "/opt/spotify/spotify"
        sleep 1
        setsid /opt/spotify/spotify >/dev/null 2>&1 < /dev/null &
        disown
    fi
fi

# 8. bat reads themes from a prebuilt binary cache, not the theme files
# directly - rebuild it so the new Wallust.tmTheme colors actually take
# effect (bat --theme=Wallust would otherwise silently keep the old cached
# palette and warn "Unknown theme").
if command -v bat >/dev/null; then
    bat cache --build >/dev/null 2>&1
fi

# 8b. Keep the plasmalust-wallpicker widget's thumbnail cache in sync with
# ~/Pictures/wallpapers/ - incremental (only generates missing thumbnails),
# so new wallpapers added via drag-drop show up next time the picker opens.
if [ -x "$HOME/.local/bin/plasmalust-refresh-thumbnails" ]; then
    "$HOME/.local/bin/plasmalust-refresh-thumbnails" >/dev/null 2>&1 &
fi

# 9. GRUB + login-manager theming touch root-owned system paths, so they
# need sudo - prompted for upfront in step 0. Non-fatal: if sudo was
# declined/failed, everything above (the actual desktop) has already been
# applied successfully either way. The sudo -v here is just a refresh in
# case a slow run let the credential cache from step 0 expire - normally a
# silent no-op.
#
# The login manager script is picked by checking which one is actually the
# active display-manager.service, not assumed - SDDM and plasmalogin need
# very different theming approaches (SDDM: a QML greeter theme. plasmalogin:
# syncing its own isolated system-user config), and guessing wrong means
# silently theming a display manager that was never even running.
LOGIN_MANAGER=$(basename "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)" .service)
case "$LOGIN_MANAGER" in
    sddm)    LOGIN_INSTALLER="$PLASMALUST_REPO/sddm-theme/install-sddm.sh" ;;
    plasmalogin) LOGIN_INSTALLER="$PLASMALUST_REPO/plasmalogin/install-plasmalogin.sh" ;;
    *) LOGIN_INSTALLER="" ;;
esac

if [ -x "$PLASMALUST_REPO/grub-theme/install-grub-theme.sh" ] && [ -n "$LOGIN_INSTALLER" ] && [ -x "$LOGIN_INSTALLER" ]; then
    if sudo -v; then
        sudo "$PLASMALUST_REPO/grub-theme/install-grub-theme.sh"
        sudo "$LOGIN_INSTALLER"
    else
        echo "Skipping GRUB/login manager (sudo not available) - desktop theme is still fully applied."
    fi
fi

# Recolor Papirus's folder icons to match the current accent (step 2c
# already picked the icon/cursor theme and cursor variant - this is just
# the one piece of that which needs root, since papirus-folders re-symlinks
# icons inside Papirus-Dark's system-owned directory).
if [ -f "$ICONS_CURSORS_DIR/nearest-swatch.py" ] && [ -d /usr/share/icons/Papirus-Dark ] && command -v papirus-folders >/dev/null; then
    if sudo -v; then
        PAPIRUS_COLOR=$(python3 "$ICONS_CURSORS_DIR/nearest-swatch.py" papirus "$ACCENT_HEX" 2>/dev/null || true)
        [ -n "$PAPIRUS_COLOR" ] && sudo papirus-folders -C "$PAPIRUS_COLOR" --theme Papirus-Dark
    fi
fi

echo "Theme successfully applied system-wide!"
