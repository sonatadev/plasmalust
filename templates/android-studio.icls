<scheme name="Wallust" version="142" parent_scheme="Darcula">
  <metaInfo>
    <property name="ide">AndroidStudio</property>
    <property name="originalScheme">Wallust</property>
  </metaInfo>
  <colors>
    <option name="CARET_COLOR" value="{{foreground | strip}}" />
    <option name="CARET_ROW_COLOR" value="{{color0 | strip}}" />
    <option name="SELECTION_BACKGROUND" value="{{color4 | strip}}" />
    <option name="SELECTION_FOREGROUND" value="{{background | strip}}" />
  </colors>
  <attributes>
    <option name="TEXT">
      <value>
        <option name="FOREGROUND" value="{{foreground | strip}}" />
        <option name="BACKGROUND" value="{{background | strip}}" />
      </value>
    </option>
    <option name="DEFAULT_KEYWORD">
      <value><option name="FOREGROUND" value="{{color1 | strip}}" /></value>
    </option>
    <option name="DEFAULT_STRING">
      <value><option name="FOREGROUND" value="{{color2 | strip}}" /></value>
    </option>
    <option name="DEFAULT_NUMBER">
      <value><option name="FOREGROUND" value="{{color5 | strip}}" /></value>
    </option>
    <option name="DEFAULT_FUNCTION_DECLARATION">
      <value><option name="FOREGROUND" value="{{color4 | strip}}" /></value>
    </option>
    <option name="DEFAULT_FUNCTION_CALL">
      <value><option name="FOREGROUND" value="{{color4 | strip}}" /></value>
    </option>
    <option name="DEFAULT_CLASS_NAME">
      <value><option name="FOREGROUND" value="{{color3 | strip}}" /></value>
    </option>
    <option name="DEFAULT_LINE_COMMENT">
      <value><option name="FOREGROUND" value="{{color8 | strip}}" /></value>
    </option>
    <option name="DEFAULT_BLOCK_COMMENT">
      <value><option name="FOREGROUND" value="{{color8 | strip}}" /></value>
    </option>
    <option name="DEFAULT_IDENTIFIER">
      <value><option name="FOREGROUND" value="{{color6 | strip}}" /></value>
    </option>
    <option name="DEFAULT_CONSTANT">
      <value><option name="FOREGROUND" value="{{color5 | strip}}" /></value>
    </option>
    <option name="DEFAULT_INSTANCE_FIELD">
      <value><option name="FOREGROUND" value="{{color6 | strip}}" /></value>
    </option>
  </attributes>
</scheme>
