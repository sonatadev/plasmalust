{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.cache/wallust/portrait-dither.png",
    "width": 26,
    "padding": {
      "top": 1,
      "right": 4,
      "left": 1
    }
  },
  "display": {
    "separator": " 󰁔 ",
    "color": {
      "keys": "{{color4}}"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "{{color4}}",
        "at": "{{foreground}}",
        "host": "{{color6}}"
      }
    },
    {
      "type": "separator",
      "string": "───────────────────────"
    },
    "break",
    {
      "type": "os",
      "key": "╭─󰣇",
      "keyColor": "{{color4}}"
    },
    {
      "type": "kernel",
      "key": "├─󰌽",
      "keyColor": "{{color4}}"
    },
    {
      "type": "packages",
      "key": "├─󰏖",
      "keyColor": "{{color4}}"
    },
    {
      "type": "shell",
      "key": "╰─",
      "keyColor": "{{color4}}"
    },
    "break",
    {
      "type": "wm",
      "key": "╭─",
      "keyColor": "{{color6}}"
    },
    {
      "type": "terminal",
      "key": "├─",
      "keyColor": "{{color6}}"
    },
    {
      "type": "uptime",
      "key": "╰─󰅐",
      "keyColor": "{{color6}}"
    },
    "break",
    {
      "type": "cpu",
      "key": "╭─",
      "keyColor": "{{color5}}"
    },
    {
      "type": "gpu",
      "key": "├─󰢮",
      "keyColor": "{{color5}}"
    },
    {
      "type": "memory",
      "key": "├─",
      "keyColor": "{{color5}}"
    },
    {
      "type": "disk",
      "key": "├─󰋊",
      "keyColor": "{{color5}}"
    },
    {
      "type": "battery",
      "key": "╰─󰁹",
      "keyColor": "{{color5}}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
