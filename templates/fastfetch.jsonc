{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "padding": {
      "top": 2,
      "right": 3,
      "left": 1
    },
    "color": {
      "1": "{{color4}}",
      "2": "{{color6}}"
    }
  },
  "display": {
    "separator": " 󰁔 ",
    "color": {
      "keys": "{{color4}}"
    }
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "╭─󰣇",
      "keyColor": "{{color4}}"
    },
    {
      "type": "kernel",
      "key": "├─󰌽",
      "keyColor": "{{color4}}"
    },
    {
      "type": "packages",
      "key": "├─󰏖",
      "keyColor": "{{color4}}"
    },
    {
      "type": "shell",
      "key": "╰─",
      "keyColor": "{{color4}}"
    },
    "break",
    {
      "type": "wm",
      "key": "╭─",
      "keyColor": "{{color6}}"
    },
    {
      "type": "terminal",
      "key": "├─",
      "keyColor": "{{color6}}"
    },
    {
      "type": "uptime",
      "key": "╰─󰅐",
      "keyColor": "{{color6}}"
    },
    "break",
    {
      "type": "cpu",
      "key": "╭─",
      "keyColor": "{{color5}}"
    },
    {
      "type": "gpu",
      "key": "├─󰢮",
      "keyColor": "{{color5}}"
    },
    {
      "type": "memory",
      "key": "╰─",
      "keyColor": "{{color5}}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
