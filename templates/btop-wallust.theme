# wallust-generated theme, regenerated by set-theme on each wallpaper change

theme[main_bg]="{{ background }}"
theme[main_fg]="{{ foreground }}"
theme[title]="{{ foreground }}"
theme[hi_fg]="{{ color5 }}"
theme[selected_bg]="{{ color5 }}"
theme[selected_fg]="{{ background }}"
theme[inactive_fg]="{{ color8 }}"
theme[graph_text]="{{ foreground }}"
theme[meter_bg]="{{ color8 }}"
theme[proc_misc]="{{ color5 }}"
theme[cpu_box]="{{ color5 }}"
theme[mem_box]="{{ color2 }}"
theme[net_box]="{{ color1 }}"
theme[proc_box]="{{ color6 }}"
theme[div_line]="{{ color8 }}"

theme[temp_start]="{{ color2 }}"
theme[temp_mid]="{{ color3 }}"
theme[temp_end]="{{ color1 }}"

theme[cpu_start]="{{ color2 }}"
theme[cpu_mid]="{{ color3 }}"
theme[cpu_end]="{{ color1 }}"

theme[free_start]="{{ color2 | lighten(0.2) }}"
theme[free_mid]="{{ color2 }}"
theme[free_end]="{{ color2 | darken(0.15) }}"

theme[cached_start]="{{ color6 | lighten(0.2) }}"
theme[cached_mid]="{{ color6 }}"
theme[cached_end]="{{ color6 | darken(0.15) }}"

theme[available_start]="{{ color3 | lighten(0.2) }}"
theme[available_mid]="{{ color3 }}"
theme[available_end]="{{ color3 | darken(0.15) }}"

theme[used_start]="{{ color1 | lighten(0.2) }}"
theme[used_mid]="{{ color1 }}"
theme[used_end]="{{ color1 | darken(0.15) }}"

theme[download_start]="{{ color4 | lighten(0.2) }}"
theme[download_mid]="{{ color4 }}"
theme[download_end]="{{ color4 | darken(0.15) }}"

theme[upload_start]="{{ color5 | lighten(0.2) }}"
theme[upload_mid]="{{ color5 }}"
theme[upload_end]="{{ color5 | darken(0.15) }}"

theme[process_start]="{{ color2 }}"
theme[process_mid]="{{ color6 }}"
theme[process_end]="{{ color5 }}"
