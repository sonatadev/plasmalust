#!/bin/bash
# Themed picker for the fun terminal toys - a quick-launcher menu in the
# same spirit as the "exit/kill/st/fw/dc/..." corner menus seen in
# Hyprland/conky rices, built on fzf (already wallust-themed via
# ~/.cache/wallust/fzf.sh, see .bashrc).
set -euo pipefail

declare -A TOYS=(
    [fetch]="fastfetch"
    [pride]="hyfetch"
    [matrix]="unimatrix"
    [fire]="aafire"
    [aquarium]="asciiquarium"
    [clock]="peaclock"
    [map]="mapscii"
    [monitor]="btop"
    [audio]="cava"
    [banner]="__banner"
    [bonsai]="cbonsai -S"
    [stars]="astroterm -c -C -g -u -q -a 38.11 -o 15.66"
    [palette]="__palette"
)

__banner() {
    read -rp "text> " text
    figlet "${text:-plasmalust}"
    read -rn1 -p "-- press any key --"
}

__palette() {
    mapfile -t colors < <(grep -oE '^color[0-9]+ +#[0-9A-Fa-f]{6}' ~/.config/kitty/current-theme.conf | awk '{print $2}' | sort -u)
    pastel color "${colors[@]}"
    read -rn1 -p "-- press any key --"
}

choice=$(printf '%s\n' "${!TOYS[@]}" | sort | fzf --prompt="toybox> " --height=~40% --border --reverse)
[ -n "$choice" ] || exit 0

cmd="${TOYS[$choice]}"
if [[ "$cmd" == __* ]]; then
    "$cmd"
else
    exec $cmd
fi
